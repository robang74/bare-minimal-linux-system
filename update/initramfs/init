# system up rising

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

echo Y > /sys/module/printk/parameters/time
echo 3 > /proc/sys/kernel/printk

if [ -r /bin/busybox ]; then
  mkdir -p /etc/init.d
  touch /etc/init.d/rcS /etc/fstab
  chmod +x /etc/init.d/rcS
fi

# caching filesystems

( find / >/dev/null 2>&1 & sleep 0.01 )

# enviroment config

#bttm=$(cut -d' ' -f1 /proc/uptime)
bttm=$(dmesg | sed -ne "s,\[ *\([0-9.]*\)*\] Run /init .*,\\1,p" | head -c4)
home=$(ls -1d /home /root / 2>/dev/null | tail -n1)
acnsl=$(sed '$s@.*[ /]@@' /sys/class/tty/console/active)
entrp=$(cat /proc/sys/kernel/random/entropy_avail)

export TERM=xterm HOME=$home PATH=/bin:/sbin:/usr/bin:/usr/sbin

echo
uname -a
stty -echoctl
echo -ne "Active console: $acnsl, entropy: $entrp bits
\e[?7h
      ===============================================
      Welcome to Minimal Linux System for QEMU x86_64
       System dmsg time was ${bttm}s at the 1st console
      ===============================================
       type command 'reboot -f' to shutdown this VM
"
exec /linuxrc
