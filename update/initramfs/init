export TERM=xterm PATH=/bin:/sbin:/usr/bin:/usr/sbin ENV=/etc/profile

# busybox install

if [ -x /bin/busybox ]; then
  /bin/busybox --install
  chmod +x /etc/init.d/rcS
  touch /etc/fstab
fi

# system uprising

mount -t proc procfs /proc
mount -t sysfs sysfs /sys
mount -o size=16k,nosuid -t devtmpfs tmpfs /dev
mkdir -p dev/pts && mount -t devpts devpts dev/pts

insmod   /lib/modules/uchaos_dev.ko badb_init=1
echo 3 > /proc/sys/kernel/printk
echo Y > /sys/module/printk/parameters/time
grep -E "MemAvailable:|MemTotal:" /proc/meminfo

# caching filesystems

( find / >/dev/null 2>&1 & sleep 0.01 )

# temporary folder

tmpdir="/dev/shm"
mkdir -p $tmpdir/ && chmod +t $tmpdir
if grep -qw tmpfs /proc/filesystems; then
  ramsize=$(sed -ne "s/MemAvailable: *\([0-9]\+\) kB/\\1/p" /proc/meminfo)
  shmsize="65536"; [ $ramsize -le 131072 ] && shmsize=$(( ramsize >> 2 ))
  tmpdev=/dev/zram0;
  sb=/sys/block/zram0
  if [ -e $sb/reset ]; then
    echo 1 > $sb/reset
    echo ${shmsize}k > $sb/disksize
    zsize=$(( $(cat $sb/disksize) >> 10 ))
    shmsize=
  else
    tmpdev=tmpfs
  fi
  mount -o nosuid,nodev,${shmsize:+size=${shmsize}k} -t tmpfs $tmpdev $tmpdir
  if grep -q " $tmpdir " /proc/mounts; then
    echo "Temporary $tmpdir size is ${shmsize:-$zsize} kB of ${zsize:+Z}RAM"
  fi
fi
mkdir -p $tmpdir/ && chmod +t $tmpdir

# enviroment config
exec 3>/dev/nul

home=$(ls -1d /home /root / 2>/dev/null | tail -n1)

export HOME=$home TMPDIR=$tmpdir GZTMPDIR=/tmp GZUNGZIP=/bin/zcat
echo; uname -a | sed -e "s,\(x86_64\) x86_64 x86_64,\\1,"

krnver=$(uname -r)
mkdir -p /lib/modules; ln -sf /lib/modules /lib/modules/$krnver
entrp=$(cat /proc/sys/kernel/random/entropy_avail)
acnsl=$(sed '$s@.*[ /]@@' /sys/class/tty/console/active)
HLINE=$(printf '-%.0s' $(seq 80))

dmesg -r | head -c 8192 > d.txt

if echo $krnver | grep -qe "^5.15.20[0-9]$" && which uchaos >&3; then
  test "$entrp" != "256" &&
  uchaos -qZK1 -k /dev/random < d.txt | md5sum 2>&1 | grep . |\
    sed -e "s,  -$, --> /dev/random by uChaos,"
  entrq=$(cat /proc/sys/kernel/random/entropy_avail)
  printf "Active console: %s, entropy: %d -> %d bits\n" $acnsl $entrp $entrq
  dmesg | grep "random: crng init done" || echo "random: crng still crying"
  grep -qe "UCTEST=1" /proc/cmdline && source /etc/uctests
else
  printf "Active console: %s, entropy: %d bits\n" $acnsl $entrp
fi

if test -r /lib/modules/uchaos_dev.ko; then
  echo
  echo "Load, init with 8-zeros and test the /dev/uchaos"
  printf "$HLINE\n\n"
  modinfo /lib/modules/uchaos_dev.ko
# insmod /lib/modules/uchaos_dev.ko && #cat d.txt > /dev/uchaos
#     dd if=/dev/zero bs=8 count=1 of=/dev/uchaos status=none
fi
rgt() {
  RNG_test.gz.sh stdin64 -tlshow 16M "$@" 2>&1|\
  sed -e "s,error reading from file,$HLINE,";
}
if echo $krnver | grep -qe "^5.15.202$" && which RNG_test.gz.sh >&3; then
  grep -qe "UCTEST=2" /proc/cmdline && {
    echo
    echo "UCTEST=3: testing /dev/uchaos in warm I/O reading test"
    dd if=/dev/uchaos bs=8k count=2k of=/dev/null 2>&1 | grep copied; echo
    dd if=/dev/uchaos bs=8k count=2k status=none | rgt
  }
  grep -qe "UCTEST=3" /proc/cmdline && {
    echo
    echo "UCTEST=3: testing /dev/uchaos in cold RAM reading test"
    dd if=/dev/uchaos bs=8k count=2k of=/d.ata 2>&1 | grep copied; echo
    rgt </d.ata
  }
  if test -r /lib/modules/uchaos_dev.ko; then
    grep -qe "UCTEST=4" /proc/cmdline && {
      echo
      echo "UCTEST=4: testing uchaos_dev.ko seeded /dev/random "
      entrp=$(cat /proc/sys/kernel/random/entropy_avail)
      dd if=/dev/random bs=8k status=none | rgt;
      entrq=$(cat /proc/sys/kernel/random/entropy_avail)
      printf "Kernel entropy pool available: %d --> %d\n" $entrp $entrq
    }
  fi
fi

bttm=$(dmesg | sed -ne "s,\[ *\([0-9.]*\)*\] Run /init .*,\\1,p" | head -c4)
echo -ne "\e[?7h
      ===============================================
      Welcome to Minimal Linux System for QEMU x86_64
       System dmsg time was ${bttm}s at the 1st console
      ===============================================
       type command 'reboot -f' to shutdown this VM
\n"
stty -echoctl
exec /linuxrc
